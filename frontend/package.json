{
  "name": "weather-aware-truck-routing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"e2e/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "vite build && playwright test"
  },
  "dependencies": {
    "maplibre-gl": "~5.24.1",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "zustand": "~5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "~4.11",
    "@eslint/js": "~9.39.0",
    "@playwright/test": "~1.65.1",
    "@testing-library/jest-dom": "~6.6.3",
    "@testing-library/react": "~16.3.0",
    "@testing-library/user-event": "~14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "~4.7.0",
    "@vitest/coverage-v8": "~3.2.4",
    "eslint": "~9.39.0",
    "eslint-plugin-react-hooks": "~5.2.0",
    "eslint-plugin-react-refresh": "~0.4.20",
    "globals": "~16.4.0",
    "jsdom": "~26.1.0",
    "prettier": "~3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "~8.46.0",
    "vite": "~6.4.1",
    "vitest": "~3.2.4"
  }
}
